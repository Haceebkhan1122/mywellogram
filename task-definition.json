{
    "family": "react-app-task",
    "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
    "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsExecutionRole",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "react-app",
            "image": "PLACEHOLDER_IMAGE", // Pipeline replace karegi
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "environment": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/react-app",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}